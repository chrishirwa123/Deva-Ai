# Copy this file to .env and adjust as needed.
# .env is never committed and API keys should live only here.

# --- Server ---
DEVA_HOST=127.0.0.1
DEVA_PORT=5000
DEVA_SECRET_KEY=change-this-to-a-random-string
DEVA_DEBUG=true

# --- Ollama ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120
DEVA_TEMPERATURE=0.7
DEVA_MAX_TOKENS=1024

# --- Uploads ---
DEVA_MAX_UPLOAD_MB=20

# --- Research ---
DEVA_RESEARCH_PROVIDER=duckduckgo
DEVA_SEARCH_API_KEY=
DEVA_RESEARCH_MAX_SOURCES=4
DEVA_RESEARCH_FETCH_TIMEOUT=12

# --- Retrieval tuning ---
DEVA_MAX_MEMORY_ITEMS=6
DEVA_MAX_KNOWLEDGE_CHUNKS=4
DEVA_CHUNK_SIZE=1200
